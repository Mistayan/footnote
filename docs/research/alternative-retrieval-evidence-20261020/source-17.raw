sets/primer-react-css.41e8289c1ff152bd.module.css","https://github.githubassets.com/assets/react-core.fab33199790f05d6.module.css","https://github.githubassets.com/assets/editor.aa8201aed33ba276.module.css"]},"repositories":{"values":["https://github.githubassets.com/assets/app-runtime.11d24f4ef5060b0f.module.css"]},"actions":{"values":["https://github.githubassets.com/assets/actions-3daae14443efb4c2.css"]},"pull-requests-list":{"values":["https://github.githubassets.com/assets/app-runtime.11d24f4ef5060b0f.module.css"]},"code":{"values":["https://github.githubassets.com/assets/code-b25a4886e30e3e5f.css"]},"codespaces":{"values":["https://github.githubassets.com/assets/app-runtime.11d24f4ef5060b0f.module.css"]},"diffs":{"values":["https://github.githubassets.com/assets/app-runtime.11d24f4ef5060b0f.module.css"]}}}},"title":"HNSW index bypassed when LIMIT or filter selectivity exceeds threshold · Issue #721 · pgvector/pgvector","appPayload":{"enabled_features":{"use_pull_request_subscriptions_enabled":false,"pull_request_single_subscription":true,"disable_issues_react_ssr":false,"copilot_natural_language_github_search":false,"private_avatars":false,"reserved_domain":true,"notifyd_issue_watch_activity_notify":false,"notifyd_enable_issue_thread_subscriptions":false,"timeline_best_effort_count_optimization":false,"copilot_auto_assign_metadata":false,"copilot_workspace_cross_repo_selection":false,"copilot_agent_mode":false,"issues_react_force_turbo_nav":false,"issues_react_client_side_caching":false,"copilot_swe_agent":false,"react_version_mismatch_detection":false,"issues_react_graceful_not_found_handling":false,"issue_viewer_activity_tab":false,"issue_create_relationships":false,"milestone_closed_issues_prioritization":true,"tasklist_block":false,"issues_create_semantic_similarity_analytics":false,"semantic_similarity_duplicate_issue_detection":true,"issue_cca_visualization":false,"scribe_artifacts_api":false,"issue_pinned_views":true,"issue_pinned_views_team_vs_personal":true,"issue_granular_statuses":false,"repo_issues_board_view":false,"milestone_show_data_router":true,"issues_inline_label_creation":false,"issues_inline_milestone_creation":false,"issues_unread_search_sort":false,"issues_bulk_mark_read":false,"move_new_comments_ui":false,"cotd_derive_thread_previews":false,"prx_dynamic_split_pref":false,"prx_files":false,"pulls-files-skip-prefer-any-solo-entry":false,"generate_groups_on_files_view":false,"prx_robust_small_screen_support":false,"prs_contextual_comment_controls":true,"pull_request_stacks":true,"pull_request_stacks_show_all_entries_statuses":true,"cotd_ui":true,"ci_analysis_check_runs_ui_enabled":false,"pull_request_merge_status_button_opt_out":false,"authentic_contributions_frontend":false,"react_data_router_pull_request_files":false,"repo_pulls_dashboard_surface":true,"prs_overview_as_index_route":false,"actions_runners_react_view":false,"repo_releases_and_tags_sidebar_layout":false}},"meta":{"title":"HNSW index bypassed when LIMIT or filter selectivity exceeds threshold · Issue #721 · pgvector/pgvector","protoRoutes":["repoLayoutRoute"]}}</script>
  <div data-target="react-app.reactRoot"><link rel="preload" as="image" href="https://avatars.githubusercontent.com/u/17111474?u=c9f77b858841bc7871ed67e25d095d2688b760dd&amp;v=4&amp;size=48"/><link rel="preload" as="image" href="https://avatars.githubusercontent.com/u/220358?u=ba13f3240d7992dc4124a33a4fc65bf4924e5375&amp;v=4&amp;size=48"/><link rel="preload" as="image" href="https://avatars.githubusercontent.com/u/220358?s=64&amp;u=ba13f3240d7992dc4124a33a4fc65bf4924e5375&amp;v=4"/><meta name="react-app-name" content="issues"/><a hidden="" id="code-view-repo-link" href="/pgvector/pgvector" data-discover="true"></a><!--$--><!--$--><script type="application/ld+json">{"@context":"https://schema.org","@type":"DiscussionForumPosting","headline":"HNSW index bypassed when LIMIT or filter selectivity exceeds threshold","articleBody":"I've got a query that only uses the HNSW index sometimes, and the query planner chooses not to use the index in two conditions per my observations:\r\n1. Size of the `LIMIT` is too high\r\n2. Values of the filters in the `WHERE` clause return a larger number of values \r\n\r\nHere's some context of my setup:\r\n- I've got 3 tables -- _tag_, _taggeditem_ and _segment_\r\n- I'm trying to filter on two columns on the _tag_ tabled named `category` and `name`. I have btree indexes on both these columns\r\n- My HNSW index is built like so:\r\n```sql\r\nCREATE INDEX s_embedding_idx_shot ON segment USING hnsw (embedding halfvec_cosine_ops) WITH (m='32', ef_construction='128') WHERE ((category)::text = 'Shot'::text)\r\n```\r\n\r\n---\r\n\r\nHere's how I'm doing my tag + vector search\r\n```sql\r\nBEGIN;\r\n\r\nSET LOCAL hnsw.ef_search = 200;\r\nSET LOCAL hnsw.iterative_scan = 'strict_order';\r\nSET LOCAL hnsw.max_scan_tuples = 20000;\r\nSET LOCAL hnsw.scan_mem_multiplier = 2;\r\n\r\n-- EXPLAIN (ANALYZE, COSTS, VERBOSE, BUFFERS)\r\nSELECT \"segment\".\"id\"\r\n  FROM \"segment\"\r\n INNER JOIN \"taggeditem\"\r\n    ON (\"segment\".\"id\" = \"taggeditem\".\"object_id\")\r\n INNER JOIN \"tag\"\r\n    ON (\"taggeditem\".\"tag_id\" = \"tag\".\"id\")\r\n WHERE (\r\n   -- Tag filters\r\n   \"tag\".\"category\" = 'Cinematography'\r\n   AND \"tag\".\"name\" = 'Wide Framing'\r\n   -- Vector filter\r\n   AND \"segment\".\"category\" IN ('Shot')\r\n   AND (\"segment\".\"embedding\" \u003c=> '[vector]') \u003c 0.9)\r\n ORDER BY (\"segment\".\"embedding\" \u003c=> '[vector]')\r\n LIMIT 100;\r\nCOMMIT;\r\n```\r\n\r\n### With `LIMIT 100`, the vector index is **not** used.\r\n\r\n\u003cdetails>\r\n\u003csummary>\r\nClick to expand query plan\r\n\u003c/summary>\r\n\r\n```sql\r\nLimit  (cost=498348.89..498360.39 rows=100 width=24) (actual time=3419.236..3419.356 rows=100 loops=1)\r\n   Output: segment.id, ((segment.embedding \u003c=> '[vector]'::halfvec))\r\n   Buffers: shared hit=2237943\r\n   ->  Gather Merge  (cost=498348.89..498435.60 rows=754 width=24) (actual time=3419.234..3419.344 rows=100 loops=1)\r\n         Output: segment.id, ((segment.embedding \u003c=> '[vector]'::halfvec))\r\n         Workers Planned: 1\r\n         Workers Launched: 1\r\n         Buffers: shared hit=2237943\r\n         ->  Sort  (cost=497348.88..497350.76 rows=754 width=24) (actual time=1795.739..1795.749 rows=94 loops=2)\r\n               Output: segment.id, ((segment.embedding \u003c=> '[vector]'::halfvec))\r\n               Sort Key: ((segment.embedding \u003c=> '[vector]'::halfvec))\r\n               Sort Method: top-N heapsort  Memory: 36kB\r\n               Buffers: shared hit=2237943\r\n               Worker 0:  actual time=172.889..172.902 rows=100 loops=1\r\n                 Sort Method: top-N heapsort  Memory: 37kB\r\n                 Buffers: shared hit=193058\r\n               ->  Nested Loop  (cost=358.73..497320.06 rows=754 width=24) (actual time=1.777..1790.919 rows=23430 loops=2)\r\n                     Output: segment.id, (segment.embedding \u003c=> '[vector]'::halfvec)\r\n                     Inner Unique: true\r\n                     Buffers: shared hit=2237934\r\n                     Worker 0:  actual time=3.068..172.053 rows=3588 loops=1\r\n                       Buffers: shared hit=193049\r\n                     ->  Nested Loop  (cost=358.30..437800.76 rows=12886 width=16) (actual time=1.659..1048.770 rows=206741 loops=2)\r\n                           Output: taggeditem.object_id\r\n                           Buffers: shared hit=248641\r\n                           Worker 0:  actual time=3.010..47.407 rows=34006 loops=1\r\n                             Buffers: shared hit=31444\r\n                           ->  Parallel Index Scan using tag_pkey on public.tag  (cost=0.29..10892.86 rows=4 width=16) (actual time=0.039..3.625 rows=3 loops=2)\r\n                                 Output: tag.id\r\n                                 Filter: (((tag.category)::text = 'Cinematography'::text) AND ((tag.name)::text = 'Wide Framing'::text))\r\n                                 Rows Removed by Filter: 11114\r\n                                 Buffers: shared hit=11064\r\n                                 Worker 0:  actual time=0.057..7.125 rows=4 loops=1\r\n                                   Buffers: shared hit=11025\r\n                           ->  Bitmap Heap Scan on public.taggeditem  (cost=358.02..106405.11 rows=32187 width=32) (actual time=9.023..339.374 rows=68914 loops=6)\r\n                                 Output: taggeditem.created, taggeditem.modified, taggeditem.id, taggeditem.object_id, taggeditem.confidence, taggeditem.tag_type, taggeditem.content_type_id, taggeditem.owner_id, taggeditem.tag_id\r\n                                 Recheck Cond: (taggeditem.tag_id = tag.id)\r\n                                 Rows Removed by Index Recheck: 1764739\r\n                                 Heap Blocks: exact=49462 lossy=167390\r\n                                 Buffers: shared hit=237577\r\n                                 Worker 0:  actual time=1.419..8.711 rows=8502 loops=4\r\n                                   Buffers: shared hit=20419\r\n                                 ->  Bitmap Index Scan on taggeditem_tag_id_9037c8bd  (cost=0.00..349.97 rows=32187 width=0) (actual time=6.939..6.939 rows=68914 loops=6)\r\n                                       Index Cond: (taggeditem.tag_id = tag.id)\r\n                                       Buffers: shared hit=348\r\n                                       Worker 0:  actual time=0.742..0.742 rows=8502 loops=4\r\n                                         Buffers: shared hit=42\r\n                     ->  Index Scan using segment_pkey on public.segment  (cost=0.43..4.62 rows=1 width=835) (actual time=0.003..0.003 rows=0 loops=413482)\r\n                           Output: segment.id, segment.embedding\r\n                           Index Cond: (segment.id = taggeditem.object_id)\r\n                           Filter: (((segment.category)::text = 'Shot'::text) AND ((segment.embedding \u003c=> '[vector]'::halfvec) \u003c '0.9'::double precision))\r\n                           Rows Removed by Filter: 1\r\n                           Buffers: shared hit=1873169\r\n                           Worker 0:  actual time=0.003..0.003 rows=0 loops=34006\r\n                             Buffers: shared hit=153353\r\n Query Identifier: -3296060046874035074\r\n Planning:\r\n   Buffers: shared hit=35\r\n Planning Time: 3.294 ms\r\n Execution Time: 3420.343 ms\r\n```\r\n\r\n\u003c/details>\r\n\r\n[Query Plan Visualisation](https://explain.dalibo.com/plan/0e569633acb4e5h5)\r\n\r\n\u003cbr>\r\n\r\n### With `LIMIT 50`, the vector index **is** used.\r\n\r\n\u003cdetails>\r\n\u003csummary>\r\nClick to expand query plan\r\n\u003c/summary>\r\n\r\n```\r\nLimit  (cost=2898.19..479096.12 rows=50 width=24) (actual time=3.194..64.412 rows=50 loops=1)\r\nOutput: segment.id, ((segment.embedding \u003c=> '[vector]'::halfvec))\r\nBuffers: shared hit=34479\r\n->  Nested Loop  (cost=2898.19..12212613.14 rows=1282 width=24) (actual time=3.193..64.399 rows=50 loops=1)\r\n      Output: segment.id, (segment.embedding \u003c=> '[vector]'::halfvec)\r\n      Inner Unique: true\r\n      Buffers: shared hit=34479\r\n      ->  Nested Loop  (cost=2897.89..12082779.67 rows=4749735 width=851) (actual time=0.947..45.374 rows=30087 loops=1)\r\n            Output: segment.id, segment.embedding, taggeditem.tag_id\r\n            Buffers: shared hit=24850\r\n            ->  Index Scan using s_embedding_idx_shot on public.segment  (cost=2897.32..2187653.01 rows=198711 width=835) (actual time=0.927..19.427 rows=2649 loops=1)\r\n                  Output: segment.id, segment.embedding\r\n                  Order By: (segment.embedding \u003c=> '[vector]'::halfvec)\r\n                  Filter: ((segment.embedding \u003c=> '[vector]'::halfvec) \u003c '0.9'::double precision)\r\n                  Buffers: shared hit=11165\r\n            ->  Index Scan using taggeditem_object_id_c44701f4 on public.taggeditem  (cost=0.57..42.69 rows=711 width=32) (actual time=0.005..0.007 rows=11 loops=2649)\r\n                  Output: taggeditem.created, taggeditem.modified, taggeditem.id, taggeditem.object_id, taggeditem.confidence, taggeditem.tag_type, taggeditem.content_type_id, taggeditem.owner_id, taggeditem.tag_id\r\n                  Index Cond: (taggeditem.object_id = segment.id)\r\n                  Buffers: shared hit=13685\r\n      ->  Memoize  (cost=0.30..4.41 rows=1 width=16) (actual time=0.000..0.000 rows=0 loops=30087)\r\n            Output: tag.id\r\n            Cache Key: taggeditem.tag_id\r\n            Cache Mode: logical\r\n            Hits: 26920  Misses: 3167  Evictions: 0  Overflows: 0  Memory Usage: 248kB\r\n            Buffers: shared hit=9501\r\n            ->  Index Scan using tag_pkey on public.tag  (cost=0.29..4.40 rows=1 width=16) (actual time=0.002..0.002 rows=0 loops=3167)\r\n                  Output: tag.id\r\n                  Index Cond: (tag.id = taggeditem.tag_id)\r\n                  Filter: (((tag.category)::text = 'Cinematography'::text) AND ((tag.name)::text = 'Wide Framing'::text))\r\n                  Rows Removed by Filter: 1\r\n                  Buffers: shared hit=9501\r\nQuery Identifier: -3296060046874035074\r\nPlanning:\r\nBuffers: shared hit=35\r\nPlanning Time: 3.325 ms\r\nExecution Time: 64.475 ms\r\n```\r\n\r\n\u003c/details>\r\n\r\n[Query Plan Visualisation](https://explain.dalibo.com/plan/62dc4cc4623f35a5)\r\n\r\n---\r\n\r\nSimilar to above, I've also noticed a similar pattern with different numbers when I change the values that I'm filtering by. Specifically, I changed `category='AssetType'` and `name='TV Ad'` (stats on these below).\r\nWhen I change it to these values that are more frequently occuring in the _tag_ table than the ones shown above, I see the exact same pattern, but with `LIMIT 20` and `LIMIT 10`, where limiting to 10 results uses the vector index whereas 20 does not. \r\n\r\nThis pattern makes me think if perhaps it's a memory issue?\r\nMy `shared_buffers` is currently set to '4GB', which is 25% of the memory on the machine. \r\n\r\nMy tables are not extremely large. Here are some stats that might be relevant:\r\n- _tag_ table size: 22,233\r\n- _taggeditem_ table size: 81,176,748\r\n- _segment_ table size: 3,969,216\r\n- no. of _taggeditem_s for (`category`='Cinematography' + `name`='Wide Framing') = 413,482\r\n- no. of _taggeditem_s for (`category`='AssetType' + `name`='TV Ad') = 3,124,493\r\n\r\nIs this kind of behavior expected? I expect the tables to grow to billions of rows, and would appreciate any insight into how to mitigate this and make the same query consistently use the index regardless of the values one's filtering by.\r\n\r\n","author":{"url":"https://github.com/rsomani95","@type":"Person","name":"rsomani95"},"datePublished":"2024-11-28T09:31:26Z","url":"https://github.com/pgvector/pgvector/issues/721"}</script><div class="issueViewerContainer__i-3HrC mainContainer__O3kakG"><div class="Layout__I4d2xw" data-artifacts-panel-open="false" data-docked-panel-open="false" data-testid="issue-artifacts-panel-layout"><div style="--spacing:var(--spacing-none)" class="prc-PageLayout-PageLayoutRoot--KH-d" data-component="SplitPageLayout" data-has-sidebar="true"><div class="prc-PageLayout-SidebarWrapper-kLG4B SidePanel__rd5eqD HiddenSidePanel__4pJ7G-" style="--spacing-column:var(--spacing-none)" data-is-hidden="false" data-position="end" data-sticky="true" data-responsive-variant="fullscreen"><div class="prc-PageLayout-VerticalDivider-9QRmK prc-PageLayout-SidebarVerticalDivider-0Rl0V" data-component="PageLayout.VerticalDivider" data-variant="none" data-position="end" style="--spacing:var(--spacing-none)"></div><div class="prc-PageLayout-Sidebar-iciWg" data-component="SplitPageLayout.Sidebar" style="--spacing:var(--spacing-none);--pane-min-width:450px;--pane-max-width:768px;--pane-width-custom:544px;--pane-width-size:var(--pane-width-custom);--pane-width:544px"><div class="height-full"><div class="height-full" hidden=""></div></div></div></div><div class="prc-PageLayout-PageLayoutWrapper-2BhU2" data-width="full"><div class="prc-PageLayout-PageLayoutContent-BneH9"><div data-component="SplitPageLayout.Content" class="prc-PageLayout-ContentWrapper-gR9eG Content__YMK67W" data-is-hidden="false"><div class="prc-PageLayout-Content-xWL-A" data-width="full" style="--spacing:var(--spacing-none)"><div class="IssueContent__7Jatit"><div class="contentContainer__6-VbUZ"><div aria-label="Header" role="region" data-testid="issue-header" class="headerRegion__itTtan"><div class="prc-PageHeader-PageHeader-YLwBQ headerContainer__MoQpha" data-component="PageHeader" data-title-size-variant="medium"><div class="prc-PageHeader-TitleArea-2n2J0 PageHeader_TitleArea__bZM3Nm" data-component="TitleArea" data-size-variant="medium"><h1 class="prc-PageHeader-Title-p0Mgh PageHeader_Title__h1a4sE PageHeader_Title_viewport__Hk8eok PageHeader_Title_marginRight__RB_Qdt prc-Heading-Heading-MtWFE" data-component="PH_Title" data-hidden="false"><bdi class="markdown-title issueTitle__zprx8E" data-testid="issue-title">HNSW index bypassed when LIMIT or filter selectivity exceeds threshold</bdi><span class="d-inline-flex flex-items-center gap-1"><span class="issueNumberText__ZPJKLj"> <!-- -->#721</span></span></h1></div><div class="prc-PageHeader-ContextArea-ueeWv" data-component="PageHeader.ContextArea" data-hidden-regular="true"><div class="prc-PageHeader-ContextAreaActions-DLQP5 PageHeader_ContextAreaActions__SeBV-R" data-component="PageHeader.ContextAreaActions" data-hidden-regular="true"><div class="menuActionsContainer__S_GMw3"><div class="buttonContainer__vr9aLP buttonContainer_viewport__DShq_j"><!--$!--><template></template><div data-loading-wrapper="true"><button data-component="Button" type="button" class="prc-Button-ButtonBase-9n-Xk" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="primary"><span data-component="buttonContent" data-align="center" class="prc-Button-ButtonContent-Iohp5"><span data-component="text" class="prc-Button-Label-FWkx3">New issue</span></span></button></div><!--/$--></div><button data-component="IconButton" type="button" class="prc-Button-ButtonBase-9n-Xk prc-Button-IconButton-fyge7" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="invisible" aria-labelledby="_R_158mtkp85_"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-copy" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg></button><span class="tooltip__XwO6MO prc-TooltipV2-Tooltip-tLeuB" data-direction="s" data-component="Tooltip" aria-label="Copy link" aria-hidden="true" id="_R_158mtkp85_">Copy link</span></div></div></div><div class="prc-PageHeader-Actions-wawWm PageHeader_Actions__zkcrVC PageHeader_Actions_viewport__Z5e1u6" data-component="PH_Actions"><div class="menuActionsContainer__S_GMw3"><div class="buttonContainer__vr9aLP buttonContainer_viewport__DShq_j"><!--$!--><template></template><div data-loading-wrapper="true"><button data-component="Button" type="button" class="prc-Button-ButtonBase-9n-Xk" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="primary"><span data-component="buttonContent" data-align="center" class="prc-Button-ButtonContent-Iohp5"><span data-component="text" class="prc-Button-Label-FWkx3">New issue</span></span></button></div><!--/$--></div><button data-component="IconButton" type="button" class="prc-Button-ButtonBase-9n-Xk prc-Button-IconButton-fyge7" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="invisible" aria-labelledby="_R_198mtkp85_"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-copy" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg></button><span class="tooltip__XwO6MO prc-TooltipV2-Tooltip-tLeuB" data-direction="s" data-component="Tooltip" aria-label="Copy link" aria-hidden="true" id="_R_198mtkp85_">Copy link</span></div></div></div></div></div><div class="contentContainer__6-VbUZ"><div data-testid="issue-metadata-fixed" class="metadataContainer__96Nc0m"><div class="metadataBorder__n2DeBH metadataBorder_inlineAvatars__vkh3R7"><div class="metadataContent__tO2lBl"><div><span data-testid="header-state" class="prc-StateLabel-StateLabel-Iawzp stateLabel__opcfNS" data-component="StateLabel" data-size="medium" data-status="issueClosed"><svg data-component="Octicon" focusable="false" aria-label="Issue" class="octicon octicon-issue-closed prc-StateLabel-Icon-YICrR" role="img" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M11.28 6.78a.75.75 0 0 0-1.06-1.06L7.25 8.69 5.78 7.22a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l3.5-3.5Z"></path><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0Zm-1.5 0a6.5 6.5 0 1 0-13 0 6.5 6.5 0 0 0 13 0Z"></path></svg>Closed</span></div><!--$--><!--/$--></div></div></div></div><div data-testid="issue-metadata-sticky" id="issue-viewer-sticky-header" class="stickyContainer__Chi3ru stickyContainerHidden__wy3FC8"><div class="contentContainer__6-VbUZ"><div class="stickyContent__JSxAHz"><div><span data-testid="header-state" class="prc-StateLabel-StateLabel-Iawzp stateLabel__opcfNS" data-component="StateLabel" data-size="medium" data-status="issueClosed"><svg data-component="Octicon" focusable="false" aria-label="Issue" class="octicon octicon-issue-closed prc-StateLabel-Icon-YICrR" role="img" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M11.28 6.78a.75.75 0 0 0-1.06-1.06L7.25 8.69 5.78 7.22a.75.75 0 0 0-1.06 1.06l2 2a.75.75 0 0 0 1.06 0l3.5-3.5Z"></path><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0Zm-1.5 0a6.5 6.5 0 1 0-13 0 6.5 6.5 0 0 0 13 0Z"></path></svg>Closed</span></div><div class="titleAndMetadata__rhT5IK"><div class="stickyTitleContainer__et53UM"><a class="stickyTitleLink__ymVVre prc-Link-Link-9ZwDx" data-component="Link" href="/pgvector/pgvector/issues/721#top" data-discover="true"><bdi class="markdown-title" data-testid="issue-title-sticky">HNSW index bypassed when LIMIT or filter selectivity exceeds threshold</bdi></a><span class="issueNumberText__rckGJl">#721</span></div><div class="smallMetadataRow__gR9GFk smallMetadataRow_viewport__Mc1gzB"><!--$--><!--/$--></div></div><div><div class="menuActionsContainer__S_GMw3"><button data-component="IconButton" type="button" class="prc-Button-ButtonBase-9n-Xk prc-Button-IconButton-fyge7" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="invisible" aria-labelledby="_R_3p6tkp85_"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-copy" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg></button><span class="tooltip__XwO6MO prc-TooltipV2-Tooltip-tLeuB" data-direction="s" data-component="Tooltip" aria-label="Copy link" aria-hidden="true" id="_R_3p6tkp85_">Copy link</span></div></div></div></div></div><div class="contentContainer__6-VbUZ"></div><div class="stickyObservableBox__hkOuz1"></div><div class="HeaderContentWrapper__iMgvTd HeaderContentWrapper_inlineAvatars__uNVYAK"><div class="contentContainer__6-VbUZ"><div class="headerSpacer__q-zg6l"></div></div></div><div class="stickyHeaderSentinel__lNt767" aria-hidden="true"></div><div class="contentContainer__6-VbUZ"><div class="contentAndSidebarWrapper__RbrYO4 contentAndSidebarWrapper_viewport__0Npf5F"><div class="contentArea__-5lt60 contentArea_viewport__l6BoO2"><div data-testid="issue-viewer-issue-container" tabindex="-1"><div class="outerContainer__iY934Y"><div data-testid="issue-body" class="react-issue-body innerContainer__mxK8FR" data-hpc="true" containertiming="hpc"><h2 class="sr-only">Description</h2><div class="headerRow__U6n1NK"><div class="commentBorder__V4zML9"><div class="IssueBodyHeaderContainer__FFEvZk IssueBodyHeaderContainer_inlineAvatars__jtIrNF viewerDidNotAuthor__ZuIsgG"><div class="activityHeader__V45NcJ activityHeaderWrapper__lI1Kau"><div class="avatarContainer__JXz0Zl"><a class="avatarLink__sqWzwe prc-Link-Link-9ZwDx" data-component="Link" href="https://github.com/rsomani95" aria-label="@rsomani95&#x27;s profile"><img data-component="Avatar" class="prc-Avatar-Avatar-0xaUi" alt="@rsomani95" width="24" height="24" style="--avatarSize-regular:24px" src="https://avatars.githubusercontent.com/u/17111474?u=c9f77b858841bc7871ed67e25d095d2688b760dd&amp;v=4&amp;size=48" data-testid="github-avatar"/></a></div><div class="narrowViewportWrapper__C5cNkS narrowViewportWrapper__Uis-SQ"><div class="titleSection__PUvpxr"><a class="authorLoginLink__51Riy1 prc-Link-Link-9ZwDx" data-component="Link" href="https://github.com/rsomani95" data-testid="issue-body-header-author">rsomani95</a></div><div class="footer__7ecx1m footerSection__kzv2bq"><span>opened </span><a class="dateLink__IC75fj prc-Link-Link-9ZwDx" data-component="Link" href="https://github.com/pgvector/pgvector/issues/721#issue-2701463268" data-testid="issue-body-header-link"><relative-time class="RelativeTime__isT-DQ" data-component="RelativeTime">on Nov 28, 2024</relative-time></a></div></div><div class="narrowViewportWrapper__C5cNkS actionsWrapper__rTb725"><div class="edits__KjKzVq editsSection__3L_O_u"></div><div class="badgesSection__IjiaLx"><div class="badgeGroup__ZvfmMk"></div><div class="actionsSection__QKxX29"><button data-component="IconButton" type="button" aria-haspopup="true" aria-expanded="false" tabindex="0" class="prc-Button-ButtonBase-9n-Xk prc-Button-IconButton-fyge7" data-loading="false" data-no-visuals="true" data-size="small" data-variant="invisible" aria-labelledby="_R_3uldl4utkp85_" id="_R_6ldl4utkp85_"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-kebab-horizontal" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M8 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM1.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm13 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path></svg></button><span class="prc-TooltipV2-Tooltip-tLeuB" data-direction="s" data-component="Tooltip" aria-hidden="true" id="_R_3uldl4utkp85_">Issue body actions</span></div></div></div></div></div><div class="IssueBody__1iGjHw" id="issue-body-viewer" data-testid="issue-body-viewer"><div data-testid="markdown-body" data-team-hovercards-enabled="true" class="markdown-body" data-turbolinks="false"><div class="markdown-body safe-html-box__Uwc6Al"><p dir="auto">I've got a query that only uses the HNSW index sometimes, and the query planner chooses not to use the index in two conditions per my observations:</p>
<ol dir="auto">
<li>Size of the <code class="notranslate">LIMIT</code> is too high</li>
<li>Values of the filters in the <code class="notranslate">WHERE</code> clause return a larger number of values</li>
</ol>
<p dir="auto">Here's some context of my setup:</p>
<ul dir="auto">
<li>I've got 3 tables -- <em>tag</em>, <em>taggeditem</em> and <em>segment</em></li>
<li>I'm trying to filter on two columns on the <em>tag</em> tabled named <code class="notranslate">category</code> and <code class="notranslate">name</code>. I have btree indexes on both these columns</li>
<li>My HNSW index is built like so:</li>
</ul>
<div class="highlight highlight-source-sql notranslate position-relative overflow-auto" dir="auto" data-snippet-clipboard-copy-content="CREATE INDEX s_embedding_idx_shot ON segment USING hnsw (embedding halfvec_cosine_ops) WITH (m='32', ef_construction='128') WHERE ((category)::text = 'Shot'::text)"><pre class="notranslate"><span class="pl-k">CREATE</span> <span class="pl-k">INDEX</span> <span class="pl-en">s_embedding_idx_shot</span> <span class="pl-k">ON</span> segment USING hnsw (embedding halfvec_cosine_ops) WITH (m<span class="pl-k">=</span><span class="pl-s"><span class="pl-pds">'</span>32<span class="pl-pds">'</span></span>, ef_construction<span class="pl-k">=</span><span class="pl-s"><span class="pl-pds">'</span>128<span class="pl-pds">'</span></span>) <span class="pl-k">WHERE</span> ((category)::<span class="pl-k">text</span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">'</span>Shot<span class="pl-pds">'</span></span>::<span class="pl-k">text</span>)</pre></div>
<hr>
<p dir="auto">Here's how I'm doing my tag + vector search</p>
<div class="highlight highlight-source-sql notranslate position-relative overflow-auto" dir="auto" data-snippet-clipboard-copy-content="BEGIN;

SET LOCAL hnsw.ef_search = 200;
SET LOCAL hnsw.iterative_scan = 'strict_order';
SET LOCAL hnsw.max_scan_tuples = 20000;
SET LOCAL hnsw.scan_mem_multiplier = 2;

-- EXPLAIN (ANALYZE, COSTS, VERBOSE, BUFFERS)
SELECT &quot;segment&quot;.&quot;id&quot;
  FROM &quot;segment&quot;
 INNER JOIN &quot;taggeditem&quot;
    ON (&quot;segment&quot;.&quot;id&quot; = &quot;taggeditem&quot;.&quot;object_id&quot;)
 INNER JOIN &quot;tag&quot;
    ON (&quot;taggeditem&quot;.&quot;tag_id&quot; = &quot;tag&quot;.&quot;id&quot;)
 WHERE (
   -- Tag filters
   &quot;tag&quot;.&quot;category&quot; = 'Cinematography'
   AND &quot;tag&quot;.&quot;name&quot; = 'Wide Framing'
   -- Vector filter
   AND &quot;segment&quot;.&quot;category&quot; IN ('Shot')
   AND (&quot;segment&quot;.&quot;embedding&quot; &lt;=&gt; '[vector]') &lt; 0.9)
 ORDER BY (&quot;segment&quot;.&quot;embedding&quot; &lt;=&gt; '[vector]')
 LIMIT 100;
COMMIT;"><pre class="notranslate"><span class="pl-k">BEGIN</span>;

<span class="pl-k">SET</span> LOCAL <span class="pl-c1">hnsw</span>.<span class="pl-c1">ef_search</span> <span class="pl-k">=</span> <span class="pl-c1">200</span>;
<span class="pl-k">SET</span> LOCAL <span class="pl-c1">hnsw</span>.<span class="pl-c1">iterative_scan</span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">'</span>strict_order<span class="pl-pds">'</span></span>;
<span class="pl-k">SET</span> LOCAL <span class="pl-c1">hnsw</span>.<span class="pl-c1">max_scan_tuples</span> <span class="pl-k">=</span> <span class="pl-c1">20000</span>;
<span class="pl-k">SET</span> LOCAL <span class="pl-c1">hnsw</span>.<span class="pl-c1">scan_mem_multiplier</span> <span class="pl-k">=</span> <span class="pl-c1">2</span>;

<span class="pl-c"><span class="pl-c">--</span> EXPLAIN (ANALYZE, COSTS, VERBOSE, BUFFERS)</span>
<span class="pl-k">SELECT</span> <span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>id<span class="pl-pds">"</span></span>
  <span class="pl-k">FROM</span> <span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>
 <span class="pl-k">INNER JOIN</span> <span class="pl-s"><span class="pl-pds">"</span>taggeditem<span class="pl-pds">"</span></span>
    <span class="pl-k">ON</span> (<span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>id<span class="pl-pds">"</span></span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">"</span>taggeditem<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>object_id<span class="pl-pds">"</span></span>)
 <span class="pl-k">INNER JOIN</span> <span class="pl-s"><span class="pl-pds">"</span>tag<span class="pl-pds">"</span></span>
    <span class="pl-k">ON</span> (<span class="pl-s"><span class="pl-pds">"</span>taggeditem<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>tag_id<span class="pl-pds">"</span></span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">"</span>tag<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>id<span class="pl-pds">"</span></span>)
 <span class="pl-k">WHERE</span> (
   <span class="pl-c"><span class="pl-c">--</span> Tag filters</span>
   <span class="pl-s"><span class="pl-pds">"</span>tag<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>category<span class="pl-pds">"</span></span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">'</span>Cinematography<span class="pl-pds">'</span></span>
   <span class="pl-k">AND</span> <span class="pl-s"><span class="pl-pds">"</span>tag<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>name<span class="pl-pds">"</span></span> <span class="pl-k">=</span> <span class="pl-s"><span class="pl-pds">'</span>Wide Framing<span class="pl-pds">'</span></span>
   <span class="pl-c"><span class="pl-c">--</span> Vector filter</span>
   <span class="pl-k">AND</span> <span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>category<span class="pl-pds">"</span></span> <span class="pl-k">IN</span> (<span class="pl-s"><span class="pl-pds">'</span>Shot<span class="pl-pds">'</span></span>)
   <span class="pl-k">AND</span> (<span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>embedding<span class="pl-pds">"</span></span> <span class="pl-k">&lt;=&gt;</span> <span class="pl-s"><span class="pl-pds">'</span>[vector]<span class="pl-pds">'</span></span>) <span class="pl-k">&lt;</span> <span class="pl-c1">0</span>.<span class="pl-c1">9</span>)
 <span class="pl-k">ORDER BY</span> (<span class="pl-s"><span class="pl-pds">"</span>segment<span class="pl-pds">"</span></span>.<span class="pl-s"><span class="pl-pds">"</span>embedding<span class="pl-pds">"</span></span> <span class="pl-k">&lt;=&gt;</span> <span class="pl-s"><span class="pl-pds">'</span>[vector]<span class="pl-pds">'</span></span>)
 <span class="pl-k">LIMIT</span> <span class="pl-c1">100</span>;
<span class="pl-k">COMMIT</span>;</pre></div>
<h3 dir="auto">With <code class="notranslate">LIMIT 100</code>, the vector index is <strong>not</strong> used.</h3>
