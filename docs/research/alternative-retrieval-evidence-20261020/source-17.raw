4I0n"><a class="HeaderLink__tMdYUU prc-Link-Link-9ZwDx" data-component="Link" href="https://github.com/pgvector/pgvector/issues/721#issuecomment-2689035998" data-turbo="true"><relative-time data-component="RelativeTime">on Feb 27, 2025</relative-time></a></span></div></div><div data-testid="comment-header-right-side-items" class="narrowViewportWrapper__C5cNkS ActionsContainer__acCGII"><div class="EditsContainer__yFuvcF"></div><div class="BadgesContainer__muaZQX"><div class="BadgesGroupContainer__W96yO7"><span class="prc-Label-Label-qG-Zu" data-size="small" data-variant="secondary" data-testid="comment-subject-author" aria-label="This user is the author of this issue" aria-describedby="_R_1b8qnteutkp85_" data-component="Label">Author</span></div><div class="ActionsButtonsContainer__ZaEPJ0"><button data-component="IconButton" type="button" aria-label="Actions for rsomani95&#x27;s comment, 8:24 PM on February 27, 2025" data-testid="comment-header-hamburger" aria-haspopup="true" aria-expanded="false" tabindex="0" class="prc-Button-ButtonBase-9n-Xk CommentActionsIconButton__rdmp8b prc-Button-IconButton-fyge7" data-loading="false" data-no-visuals="true" data-size="small" data-variant="invisible" aria-describedby="_R_1ud8qnteutkp85_" id="_R_2d8qnteutkp85_"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-kebab-horizontal" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M8 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM1.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm13 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path></svg></button><span class="prc-TooltipV2-Tooltip-tLeuB" data-direction="n" data-component="Tooltip" role="tooltip" aria-hidden="true" id="_R_1ud8qnteutkp85_">More actions</span></div></div></div></div></div><div class="IssueCommentBody__DGWd7U"><div data-testid="markdown-body" data-team-hovercards-enabled="true" class="markdown-body" data-turbolinks="false"><div class="markdown-body safe-html-box__Uwc6Al"><p dir="auto">The <code class="notranslate">pg_hint_plan</code> suggestion sent me down a bit of a rabbit hole. While it did force postgres to use the index, the quality of the results was quite inferior to brute force search (which was almost never the case when postgres decided to use the index by itself). I figured that part of the problem was that my filtering params were shaving off like 90% of the graph (not an exact number, but you get the point), so there really wasn't much space left to traverse within the HNSW graph. I ended up building a more tightly scoped index with some of the filtering params built in.</p></div></div><div role="toolbar" aria-label="Reactions" class="d-flex gap-1 flex-wrap"></div></div></div></div></div></div></div></li></ol></div><div class="prc-Flash-Flash-q6HW0 signedOutBanner__k-kNxi" data-variant="warning" data-component="Flash"><a data-component="LinkButton" href="/signup?return_to=https://github.com/pgvector/pgvector/issues/721" data-jump-to-bottom-target="true" class="prc-Button-ButtonBase-9n-Xk" data-loading="false" data-no-visuals="true" data-size="medium" data-variant="primary" id="signed-out-banner-sign-up"><span data-component="buttonContent" data-align="center" class="prc-Button-ButtonContent-Iohp5"><span data-component="text" class="prc-Button-Label-FWkx3">Sign up for free</span></span></a><span><strong> <!-- -->to join this conversation on GitHub.</strong> <!-- -->Already have an account?<!-- --> </span><a class="prc-Link-Link-9ZwDx" data-component="Link" href="/login?return_to=https://github.com/pgvector/pgvector/issues/721">Sign in to comment</a></div></div></div><!--/$--></div><div data-testid="issue-viewer-metadata-container" class="metadataSidebar__R9M5UE metadataSidebar_viewport__j6pDmg"><div class="issueViewerMetadataPane__0TiAmC" data-testid="issue-viewer-metadata-pane"><h2 class="metadataHeader__8bGnK5 prc-Heading-Heading-MtWFE" data-compon