"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}]}},{"cursor":"Y3Vyc29yOnYyOpPPAAABlQHrgLABqzE2MzA0NDcwMjU1","node":{"__typename":"ClosedEvent","id":"CE_lADOFXRw2c6hBQ7kzwAAAAPL0njv","databaseId":16304470255,"createdAt":"2025-02-14T00:46:06Z","actor":{"id":"MDQ6VXNlcjIyMDM1OA==","avatarUrl":"https://avatars.githubusercontent.com/u/220358?s=64\u0026u=ba13f3240d7992dc4124a33a4fc65bf4924e5375\u0026v=4","login":"ankane","profileResourcePath":"/ankane","__typename":"User","name":"Andrew Kane"},"stateReason":"COMPLETED","duplicateOf":null,"closingProjectItemStatus":null,"closer":null,"intent":null}},{"cursor":"Y3Vyc29yOnYyOpPPAAABlUkU3TgAqjI2ODkwMzU5OTg=","node":{"__typename":"IssueComment","id":"IC_kwDOFXRw2c6gR27e","databaseId":2689035998,"viewerDidAuthor":false,"issue":{"id":"I_kwDOFXRw2c6hBQ7k","author":{"__typename":"User","id":"MDQ6VXNlcjE3MTExNDc0","login":"rsomani95"},"number":721,"locked":false,"databaseId":2701463268},"author":{"__typename":"User","id":"MDQ6VXNlcjE3MTExNDc0","login":"rsomani95","avatarUrl":"https://avatars.githubusercontent.com/u/17111474?u=c9f77b858841bc7871ed67e25d095d2688b760dd\u0026v=4","profileUrl":"https://github.com/rsomani95","name":"Rahul Somani"},"url":"https://github.com/pgvector/pgvector/issues/721#issuecomment-2689035998","createdAt":"2025-02-27T20:24:19Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"isHidden":false,"isMinimized":false,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"The `pg_hint_plan` suggestion sent me down a bit of a rabbit hole. While it did force postgres to use the index, the quality of the results was quite inferior to brute force search (which was almost never the case when postgres decided to use the index by itself). I figured that part of the problem was that my filtering params were shaving off like 90% of the graph (not an exact number, but you get the point), so there really wasn't much space left to traverse within the HNSW graph. I ended up building a more tightly scoped index with some of the filtering params built in. ","bodyHTML":"\u003cp dir=\"auto\"\u003eThe \u003ccode class=\"notranslate\"\u003epg_hint_plan\u003c/code\u003e suggestion sent me down a bit of a rabbit hole. While it did force postgres to use the index, the quality of the results was quite inferior to brute force search (which was almost never the case when postgres decided to use the index by itself). I figured that part of the problem was that my filtering params were shaving off like 90% of the graph (not an exact number, but you get the point), so there really wasn't much space left to traverse within the HNSW graph. I ended up building a more tightly scoped index with some of the filtering params built in.\u003c/p\u003e","bodyVersion":"9037d835d4de57ddf95bf70bb278f166c4ad4f463afbfc8c13c602a30421ae4d","viewerCanUpdate":false,"repository":{"id":"MDEwOlJlcG9zaXRvcnkzNTk5NTI2MDE=","name":"pgvector","owner":{"__typename":"Organization","id":"O_kgDOBdznXg","login":"pgvector","url":"https://github.com/pgvector"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"pgvector/pgvector","databaseId":359952601},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}]}}]},"pendingSuggestions":[]}},"safeViewer":null},"feed":"activity"},"issuesLayoutRoute":{"has_projects_enabled":false,"has_labels_archiving_enabled":true,"current_user":null,"current_user_settings":{"preferred_emoji_skin_tone":null,"copilot_show_functionality":false},"sidebar_expanded":true,"pinned_views":[],"pinned_views_enabled":true,"best_match_sort_enabled":false,"issue_types_enabled":false,"issue_search_type":null,"show_issue_field_pills":false,"viewer_can_create_issues":false,"is_writable":false,"repository_id":"MDEwOlJlcG9zaXRvcnkzNTk5NTI2MDE=","can_bulk_update":false,"actions":{"new_issue":{"label":"New issue","url":"/pgvector/pgvector/issues/new","disabled_reason":null}},"compact_mode":false},"repoLayoutRoute":{"js":{"scanning":{"values":["https://github.githubassets.com/assets/wp-runtime-285f98edcab42d46.js","https://github.githubassets.com/assets/app-foundation-799625033ee8341e.js","https://github.githubassets.com/assets/aria-live-edd851c704c6b3ca.js","https://github.githubassets.com/assets/selector-observer-7ae05416e4a383ae.js","https://github.githubassets.com/assets/scanning-3f916838382c59a2.js"]},"code-menu":{"values":["https://github.githubassets.com/assets/wp-runtime-285f98edcab42d46.js","https://github.githubassets.com/assets/code-menu-7254b24dbcee4b1d.js"]},"codespaces":{"values":["https://github.githubassets.com/assets/wp-runtime-285f98edca