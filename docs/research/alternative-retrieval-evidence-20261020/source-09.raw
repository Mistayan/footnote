/* Mintlify's KaTeX stylesheet currently serves the AMS font from a broken URL. */
@font-face {
  font-family: "LanceDB KaTeX AMS";
  src: url("https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/fonts/KaTeX_AMS-Regular.woff2") format("woff2");
  font-display: swap;
  font-style: normal;
  font-weight: 400;
}

.katex .mathbb,
.katex .textbb {
  font-family: "LanceDB KaTeX AMS", "KaTeX_AMS", serif !important;
}

/* Mintlify banner gradient */
#banner,
:where(.banner, [data-banner], [class*="Banner_banner"]) {
  background: linear-gradient(90deg, var(--banner-left) 0%, var(--banner-right) 100%) !important;
  color: #1b0f09 !important;
  border: none !important;
}

#banner a,
:where(.banner, [data-banner], [class*="Banner_banner"]) a {
  color: #1b0f09 !important;
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration-color: rgba(27, 15, 9, 0.35);
}

#banner button,
:where(.banner, [data-banner], [class*="Banner_banner"]) button {
  color: #1b0f09 !important;
}
