rk:#9399B2">,</span><span style="color:#B07D48;--shiki-light-font-style:inherit;--shiki-dark:#EBA0AC;--shiki-dark-font-style:italic"> data</span><span style="color:#999999;--shiki-dark:#94E2D5">=</span><span style="color:#393A34;--shiki-dark:#CDD6F4">data</span><span style="color:#999999;--shiki-dark:#9399B2">,</span><span style="color:#B07D48;--shiki-light-font-style:inherit;--shiki-dark:#EBA0AC;--shiki-dark-font-style:italic"> schema</span><span style="color:#999999;--shiki-dark:#94E2D5">=</span><span style="color:#393A34;--shiki-dark:#CDD6F4">schema</span><span style="color:#999999;--shiki-dark:#9399B2">)</span></span>
