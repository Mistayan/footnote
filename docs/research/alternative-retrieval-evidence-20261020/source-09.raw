  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://docs.lancedb.com/#organization","name":"LanceDB","url":"https://docs.lancedb.com","logo":{"@type":"ImageObject","url":"https://mintcdn.com/lancedb-bcbb4faf/6L0IRVkfdlgMU1Pw/static/assets/logo/dark-lancedb-logo.svg?fit=max&auto=format&n=6L0IRVkfdlgMU1Pw&q=85&s=d0592e59a29df2477080a857e13e341f"}},{"@type":"WebSite","@id":"https://docs.lancedb.com#website","name":"LanceDB","url":"https://docs.lancedb.com","publisher":{"@id":"https://docs.lancedb.com/#organization"}},{"@type":"WebPage","@id":"https://docs.lancedb.com/search/multivector-search#webpage","url":"https://docs.lancedb.com/search/multivector-search","name":"Multivector Search","description":"Learn how to perform multivector search in LanceDB to handle multiple vector embeddings per document, which is ideal for late-interaction models like ColBERT and ColPaLi.","dateModified":"2026-09-26T06:01:06.410Z","isPartOf":{"@id":"https://docs.lancedb.com#website"},"breadcrumb":{"@id":"https://docs.lancedb.com/search/multivector-search#breadcrumb"}},{"@type":"BreadcrumbList","@id":"https://docs.lancedb.com/search/multivector-search#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Guides","item":"https://docs.lancedb.com/tables/index"},{"@type":"ListItem","position":2,"name":"Search","item":"https://docs.lancedb.com/search/index"},{"@type":"ListItem","position":3,"name":"Multivector Search","item":"https://docs.lancedb.com/search/multivector-search"}]},{"@type":["Article","TechArticle"],"@id":"https://docs.lancedb.com/search/multivector-search#article","headline":"Multivector Search","name":"Multivector Search","description":"Learn how to perform multivector search in LanceDB to handle multiple vector embeddings per document, which is ideal for late-interaction models like ColBE