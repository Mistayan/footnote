<span class="line"><span style="color:#393A34;--shiki-dark:#CDD6F4">results_single </span><span style="color:#999999;--shiki-dark:#94E2D5">=</span><span style="color:#393A34;--shiki-dark:#CDD6F4"> tbl</span><span style="color:#999999;--shiki-dark:#9399B2">.</span><span style="color:#393A34;--shiki-dark:#89B4FA">search</span><span style="color:#999999;--shiki-dark:#9399B2">(</span><span style="color:#393A34;--shiki-dark:#CDD6F4">query</span><span style="color:#999999;--shiki-dark:#9399B2">).</span><span style="color:#393A34;--shiki-dark:#89B4FA">limit</span><span style="color:#999999;--shiki-dark:#9399B2">(</span><span style="color:#2F798A;--shiki-dark:#FAB387">5</span><span style="color:#999999;--shiki-dark:#9399B2">).</span><span style="color:#393A34;--shiki-dark:#89B4FA">to_pandas</span><span style="color:#999999;--shiki-dark:#9399B2">()</span></span>
