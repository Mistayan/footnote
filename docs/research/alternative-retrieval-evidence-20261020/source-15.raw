	</div>
	</div> 
</div></div><div id="fws_6ad6b7d4b119f" data-midnight="" data-column-margin="default" class="wpb_row vc_row-fluid vc_row inner_row artifact-container"  style="padding-top: 40px; "><div class="row-bg-wrap"> <div class="row-bg" ></div> </div><div class="row_col_wrap_12_inner col span_12  left">
