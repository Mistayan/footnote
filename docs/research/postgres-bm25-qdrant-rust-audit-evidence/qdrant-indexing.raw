</span></span><span class=line><span class=cl>    <span class=p>{</span>
</span></span><span class=line><span class=cl>	    <span class=n>IntegerIndexParams</span> <span class=p>=</span> <span class=k>new</span><span class=p>()</span>
</span></span><span class=line><span class=cl>	    <span class=p>{</span>
