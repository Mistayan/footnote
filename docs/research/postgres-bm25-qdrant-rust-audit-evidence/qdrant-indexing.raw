</span></span><span class=line><span class=cl>    <span class=s2>&#34;text&#34;</span><span class=o>:</span> <span class=p>{</span>
</span></span><span class=line><span class=cl>      <span class=nx>index</span><span class=o>:</span> <span class=p>{}</span>
