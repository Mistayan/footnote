</span></span></span><span class=line><span class=cl><span class=w>
</span></span></span><span class=line><span class=cl><span class=n>sparse_vectors_config</span><span class=p>.</span><span class=n>add_named_vector_params</span><span class=p>(</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>    </span><span class=s>&#34;text&#34;</span><span class=p>,</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>    </span><span class=n>SparseVectorParamsBuilder</span>::<span class=n>default</span><span class=p>().</span><span class=n>index</span><span class=p>(</span><span class=n>SparseIndexConfigBuilder</span>::<span class=n>default</span><span class=p>()),</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=p>);</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>
</span></span></span><span class=line><span class=cl><span class=n>client</span><span class=w>
