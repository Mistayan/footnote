</span></span></span><span class=line><span class=cl><span class=nx>client</span><span class=p>.</span><span class=nf>CreateFieldIndex</span><span class=p>(</span><span class=nx>context</span><span class=p>.</span><span class=nf>Background</span><span class=p>(),</span><span class=w> </span><span class=o>&amp;</span><span class=nx>qdrant</span><span class=p>.</span><span class=nx>CreateFieldIndexCollection</span><span class=p>{</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>	</span><span class=nx>CollectionName</span><span class=p>:</span><span class=w> </span><span class=s>&#34;{collection_name}&#34;</span><span class=p>,</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>	</span><span class=nx>FieldName</span><span class=p>:</span><span class=w>      </span><span class=s>&#34;name_of_the_field_to_index&#34;</span><span class=p>,</span><span class=w>
</span></span></span><span class=line><span class=cl><span class=w>	</span><span class=nx>FieldType</span><span class=p>:</span><span class=w>      </span><span class=nx>qdrant</span><span class=p>.</span><span class=nx>FieldType_FieldTypeText</span><span class=p>.</span><span class=nf>Enum</span><span class=p>(),</span><span class=w>
