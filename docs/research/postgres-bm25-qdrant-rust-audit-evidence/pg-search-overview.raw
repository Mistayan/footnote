l,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L11\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L56\",null,{\"source\":\"multitenant\"}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}],\"$undefined\"]}]]}]}]}]}]\n"])</script><script>self.__next_f.push([1,"4a:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L57\",null,{\"pageMetadata\":\"$1b:props:children:props:pageMetadata\"}]]\n4b:[\"$\",\"$L58\",null,{\"pageMetadata\":\"$1b:props:children:props:pageMetadata\"}]\n5a:T266d,"])</script><script>self.__next_f.push([1,"#search-bar-entry {\n  visibility: visible;\n}\n\n#banner {\n  background-color: #4f46e5 !important;\n  background-image: none !important;\n  border-bottom: 0 !important;\n  display: flex;\n  height: 2.75rem !important;\n  max-height: none !important;\n  min-height: 2.75rem;\n  padding: 0 !important;\n}\n\n@media (min-width: 640px) {\n  #banner {\n    height: 3rem !important;\n    min-height: 3rem;\n  }\n}\n\n#banner \u003e div {\n  align-items: center;\n  backdrop-filter: blur(12px);\n  background-color: rgb(255 255 255 / 10%);\n  border-bottom: 1px solid rgb(255 255 255 / 20%) !important;\n  box-shadow: inset 0 -1px rgb(255 255 255 / 20%);\n  display: flex;\n  justify-content: center;\n  box-sizing: border-box;\n  height: 100%;\n  margin: 0 !important;\n  padding: 0.75rem 1rem;\n  width: 100%;\n}\n\n#banner p {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  height: 100%;\n  margin: 0 !important;\n  max-width: 100%;\n  min-width: 0;\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n\n#banner a {\n  color: #ffffff !important;\n  display: inline-flex;\n  align-items: center;\n  font-size: inherit;\n  font-weight: 500;\n  gap: 0.5rem;\n  line-height: inherit;\n  text-decoration: none;\n}\n\n#banner a:hover {\n  color: #ffffff !important;\n}\n\n#banner a::after {\n  content: \"-\u003e\";\n  display: inline-block;\n  flex: none;\n  transition: transform 160ms ease;\n}\n\n#banner a:hover::after {\n  transform: translateX(2px);\n}\n\n#banner .banner-badge {\n  display: none;\n  flex: none;\n  background-color: rgb(255 255 255 / 10%);\n  padding: 0.25rem 0.625rem;\n  font-size: 0.625rem;\n  font-weight: 600;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n@media (min-width: 640px) {\n  #banner p {\n    font-size: 0.875rem;\n    line-height: 1.25rem;\n  }\n\n  #banner .banner-badge {\n    display: inline-flex;\n    font-size: 0.75rem;\n  }\n}\n\n.topbar-right-container nav ul {\n  gap: 1.25rem !important;\n}\n\n.navbar-link \u003e a {\n  background: transparent !important;\n  border-radius: 0 !important;\n  color: rgb(30 41 59 / 85%) !important;\n  font-size: 0.875rem !important;\n  line-height: 1.25rem !important;\n  padding: 0.25rem 0.125rem !important;\n  transition: color 160ms ease;\n}\n\n.navbar-link \u003e a:hover {\n  background: transparent !important;\n  color: #4f46e5 !important;\n}\n\n.dark .navbar-link \u003e a {\n  color: rgb(255 255 255 / 86%) !important;\n}\n\n.dark .navbar-link \u003e a:hover {\n  color: #ffffff !important;\n}\n\nimg.nav-logo {\n  height: 2rem !important;\n}\n\n/* Larger tab bar; Mintlify's default is 0.875rem text with 1rem icons */\na.nav-tabs-item {\n  font-size: 1.0625rem !important;\n}\n\na.nav-tabs-item span[class*=\"h-4\"] {\n  height: 1.25rem !important;\n  width: 1.25rem !important;\n}\n\n.card {\n  border-radius: 0 !important;\n}\n\n#pagination \u003e a {\n  border: 0;\n  border-radius: 0;\n}\n\n.architecture-diagram {\n  --architecture-node-inset: 18px;\n  --architecture-surface: #ffffff;\n  --architecture-background: #f9fafc;\n  --architecture-border: #dfe3eb;\n  --architecture-text: #1e293b;\n  --architecture-muted: #606d82;\n  --architecture-line: #99a3b5;\n  --architecture-accent: #4f46e5;\n  --architecture-accent-soft: #eeedff;\n  --architecture-index: #f6f5ff;\n  --architecture-index-border: #ccc9f3;\n  --architecture-divider: #e0def4;\n  --architecture-shadow:\n    0 1px 2px rgb(30 27 75 / 4%), 0 4px 12px rgb(30 27 75 / 3%);\n  container-type: inline-size;\n  margin: 2.5rem 0;\n  color: var(--architecture-text);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n.dark .architecture-diagram {\n  --architecture-surface: #17171e;\n  --architecture-background: #101015;\n  --architecture-border: #30303c;\n  --architecture-text: #ececf3;\n  --architecture-muted: #a6a6b9;\n  --architecture-line: #73738c;\n  --architecture-accent-soft: #202028;\n  --architecture-index: var(--architecture-surface);\n  --architecture-index-border: #3e3e4b;\n  --architecture-divider: var(--architecture-border);\n  --architecture-shadow: 0 1px 2px rgb(0 0 0 / 12%), 0 4px 12px rgb(0 0 0 / 8%);\n}\n\n.architecture-diagram svg {\n  display: block;\n  flex: none;\n  stroke-linecap: round;\n  stroke-linejoin: miter;\n}\n\n.architecture-app {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  width: fit-content;\n  margin: 0 auto;\n  padding: 11px 20px;\n  border: 1px solid var(--architecture-border);\n  border-radius: 0;\n  background: var(--architecture-surface);\n  box-shadow: var(--architecture-shadow);\n  font-weight: 500;\n}\n\n.architecture-app svg,\n.architecture-heading svg {\n  width: 22px;\n  height: 22px;\n}\n\n.architecture-connection {\n  position: relative;\n  display: flex;\n  justify-content: center;\n  height: 48px;\n  color: var(--architecture-line);\n}\n\n.architecture-connection svg {\n  width: 16px;\n  height: 48px;\n}\n\n.architecture-connection span {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  color: var(--architecture-muted);\n  font-size: 12px;\n}\n\n.architecture-sql span {\n  left: calc(50% + 14px);\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 12px;\n  letter-spacing: 0.04em;\n}\n\n.architecture-postgres {\n  padding: 22px;\n  border: 1px solid var(--architecture-border);\n  border-radius: 0;\n  background: var(--architecture-background);\n}\n\n.architecture-database-heading,\n.architecture-index-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.architecture-database-heading {\n  margin-bottom: 22px;\n}\n\n.architecture-heading {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 16px;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n}\n\n.architecture-database-heading svg {\n  width: 1em;\n  height: 1em;\n}\n\n.architecture-table {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 17px var(--architecture-node-inset);\n  border: 1px solid var(--architecture-border);\n  border-radius: 0;\n  background: var(--architecture-surface);\n  box-shadow: var(--architecture-shadow);\n}\n\n.architecture-table-icon {\n  width: 28px;\n  height: 28px;\n  color: var(--architecture-muted);\n}\n\n.architecture-title {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.architecture-detail {\n  margin-top: 4px;\n  color: var(--architecture-muted);\n  font-size: 12px;\n  text-wrap: balance;\n}\n\n.architecture-writes {\n  justify-content: flex-start;\n  padding-left: calc(var(--architecture-node-inset) + 7px);\n}\n\n.architecture-writes span {\n  left: calc(var(--architecture-node-inset) + 41px);\n}\n\n.architecture-index {\n  overflow: hidden;\n  border: 1px solid var(--architecture-index-border);\n  border-radius: 0;\n  background: var(--architecture-index);\n  box-shadow: var(--architecture-shadow);\n}\n\n.architecture-index-heading {\n  padding: 17px var(--architecture-node-inset);\n  border-bottom: 1px solid var(--architecture-divider);\n}\n\n.architecture-index-heading .architecture-heading {\n  gap: 12px;\n}\n\n.architecture-heading .architecture-brand {\n  width: 22px;\n  height: 22px;\n  margin: 3px;\n  color: var(--architecture-accent);\n}\n\n.architecture-extension {\n  flex: none;\n  padding: 3px 7px;\n  border: 1px solid var(--architecture-divider);\n  border-radius: 0;\n  background: var(--architecture-accent-soft);\n  color: var(--architecture-text);\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n}\n\n.architecture-structures {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  padding: 24px 0 22px;\n}\n\n.architecture-structure {\n  padding: 0 6px;\n  text-align: center;\n}\n\n.architecture-structure + .architecture-structure {\n  border-left: 1px solid var(--architecture-divider);\n}\n\n.architecture-structure svg {\n  width: 56px;\n  height: 40px;\n  margin: 0 auto 14px;\n  color: var(--architecture-accent);\n}\n\n@container (max-width: 380px) {\n  .architecture-postgres {\n    --architecture-node-inset: 14px;\n    padding: 16px;\n  }\n\n  .architecture-table {\n    padding-block: 15px;\n  }\n\n  .architecture-index-heading {\n    flex-wrap: wrap;\n    gap: 6px 12px;\n    padding-block: 15px;\n  }\n\n  .architecture-structures {\n    grid-template-columns: 1fr;\n    padding: 0 14px;\n  }\n\n  .architecture-structure {\n    display: grid;\n    grid-template-columns: 48px 1fr;\n    column-gap: 16px;\n    padding: 14px 0;\n    text-align: left;\n  }\n\n  .architecture-structure + .architecture-structure {\n    border-top: 1px solid var(--architecture-divider);\n    border-left: 0;\n  }\n\n  .architecture-structure svg {\n    grid-row: span 2;\n    align-self: center;\n    width: 48px;\n    height: 32px;\n    margin: 0;\n  }\n}\n\n@container (max-width: 320px) {\n  .architecture-index-heading {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .architecture-extension {\n    margin-left: 40px;\n  }\n}\n\n.architecture-detail-diagram .architecture-svg {\n  width: 100%;\n  height: auto;\n  font-family: inherit;\n  font-size: 17px;\n  fill: var(--architecture-text);\n}\n\n.architecture-svg-boundary {\n  fill: var(--architecture-background);\n  stroke: var(--architecture-border);\n}\n\n.architecture-svg-surface {\n  fill: var(--architecture-surface);\n  stroke: var(--architecture-border);\n}\n\n.architecture-svg-index {\n  fill: var(--architecture-index);\n  stroke: var(--architecture-index-border);\n}\n\n.architecture-svg-line {\n  fill: none;\n  stroke: var(--architecture-line);\n  stroke-width: 1.5;\n}\n\n.architecture-svg-rule {\n  fill: none;\n  stroke: var(--architecture-border);\n}\n\n.architecture-svg-title {\n  font-size: 18px;\n  font-weight: 600;\n  letter-spacing: -0.02em;\n}\n\n.architecture-svg-label {\n  fill: var(--architecture-muted);\n  font-size: 14px;\n}\n\n.architecture-svg-stage-title {\n  font-size: 17px;\n  font-weight: 600;\n}\n\n.architecture-svg-small {\n  font-size: 13px;\n}\n\n.architecture-detail-diagram .architecture-svg-compact {\n  display: none;\n}\n\n@container (max-width: 420px) {\n  .architecture-detail-diagram .architecture-svg-wide {\n    display: none;\n  }\n\n  .architecture-detail-diagram .architecture-svg-compact {\n    display: block;\n    max-width: 380px;\n    margin: 0 auto;\n  }\n}\n"])</script><script>self.__next_f.push([1,"4c:[\"$\",\"$L59\",null,{\"cssFiles\":[{\"_id\":\"67e9cc2eae16dd9f4809078a\",\"filePath\":\"style.css\",\"subdomain\":\"paradedb\",\"__v\":0,\"content\":\"$5a\"}]}]\n5c:T1b64,"])</script><script>self.__next_f.push([1,"// Inject ParadeDB Organization structured data. Mintlify auto-emits only a\n// generic WebSite node (whose creator is Mintlify), so the docs otherwise have\n// no ParadeDB identity markup. Reusing the same @id as paradedb.com lets search\n// engines and agents treat both sites as one Organization entity.\n(function () {\n  if (document.querySelector(\"script[data-paradedb-org]\")) return;\n\n  const organization = {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Organization\",\n    \"@id\": \"https://www.paradedb.com/#organization\",\n    name: \"ParadeDB\",\n    legalName: \"ParadeDB, Inc.\",\n    url: \"https://www.paradedb.com\",\n    logo: {\n      \"@type\": \"ImageObject\",\n      url: \"https://www.paradedb.com/brand/paradedb-logo-light.svg\",\n    },\n    description: \"You should just use Postgres.\",\n    email: \"hello@paradedb.com\",\n    contactPoint: [\n      {\n        \"@type\": \"ContactPoint\",\n        contactType: \"customer support\",\n        email: \"support@paradedb.com\",\n      },\n      {\n        \"@type\": \"ContactPoint\",\n        contactType: \"sales\",\n        email: \"sales@paradedb.com\",\n      },\n    ],\n    sameAs: [\n      \"https://github.com/paradedb\",\n      \"https://x.com/paradedb\",\n      \"https://www.linkedin.com/company/paradedb\",\n    ],\n  };\n\n  const script = document.createElement(\"script\");\n  script.type = \"application/ld+json\";\n  script.setAttribute(\"data-paradedb-org\", \"\");\n  script.textContent = JSON.stringify(organization);\n  document.head.appendChild(script);\n})();\n\n// Keep the Start flow's framework choice consistent between regular Tabs and\n// CodeGroups. Mintlify reads CodeGroup choices into Tabs, but Tabs do not write\n// back to CodeGroups.\n(function () {\n  const storageKey = \"paradedb-docs-framework-tab\";\n  const startPaths = new Set([\n    \"/start/connect-your-app\",\n    \"/start/create-your-first-index\",\n    \"/start/run-queries\",\n  ]);\n  const frameworks = new Set([\n    \"SQL\",\n    \"Drizzle\",\n    \"Django\",\n    \"SQLAlchemy\",\n    \"Rails\",\n    \"EF Core\",\n  ]);\n  const controlSelector = [\n    '[role=\"tab\"]',\n    '[role=\"option\"]',\n    '[role=\"menuitem\"]',\n    '[role=\"menuitemradio\"]',\n    \"[data-value]\",\n  ].join(\",\");\n\n  let applyingStoredTab = false;\n  let applyQueued = false;\n\n  function isStartFlowPage() {\n    const pathname = window.location.pathname\n      .replace(/\\/$/, \"\")\n      .replace(/^\\/docs(?=\\/)/, \"\");\n\n    return startPaths.has(pathname);\n  }\n\n  function normalizeLabel(value) {\n    return (value || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function getElementFrameworkLabel(element) {\n    if (!(element instanceof HTMLElement)) {\n      return null;\n    }\n\n    return [\n      element.getAttribute(\"data-value\"),\n      element.getAttribute(\"aria-label\"),\n      element.textContent,\n    ]\n      .map(normalizeLabel)\n      .find((label) =\u003e frameworks.has(label));\n  }\n\n  function isVisible(element) {\n    return Boolean(\n      element.offsetWidth ||\n      element.offsetHeight ||\n      element.getClientRects().length,\n    );\n  }\n\n  function isFrameworkControl(element) {\n    if (!(element instanceof HTMLElement) || !isVisible(element)) {\n      return false;\n    }\n\n    if (!getElementFrameworkLabel(element)) {\n      return false;\n    }\n\n    const role = element.getAttribute(\"role\");\n    return (\n      role === \"tab\" ||\n      role === \"option\" ||\n      role === \"menuitem\" ||\n      role === \"menuitemradio\" ||\n      element.hasAttribute(\"data-value\") ||\n      element.closest('[role=\"tablist\"], [role=\"listbox\"], [role=\"menu\"]')\n    );\n  }\n\n  function isSelected(element) {\n    return (\n      element.getAttribute(\"aria-selected\") === \"true\" ||\n      element.getAttribute(\"data-state\") === \"active\"\n    );\n  }\n\n  function findFrameworkControls(label) {\n    return Array.from(document.querySelectorAll(controlSelector)).filter(\n      (element) =\u003e\n        isFrameworkControl(element) \u0026\u0026\n        getElementFrameworkLabel(element) === label,\n    );\n  }\n\n  function dispatchMouseEvent(element, type, buttons) {\n    element.dispatchEvent(\n      new MouseEvent(type, {\n        bubbles: true,\n        cancelable: true,\n        view: window,\n        button: 0,\n        buttons,\n      }),\n    );\n  }\n\n  function dispatchPointerEvent(element, type, buttons) {\n    if (!window.PointerEvent) {\n      return;\n    }\n\n    element.dispatchEvent(\n      new PointerEvent(type, {\n        bubbles: true,\n        cancelable: true,\n        view: window,\n        button: 0,\n        buttons,\n        pointerId: 1,\n        pointerType: \"mouse\",\n        isPrimary: true,\n      }),\n    );\n  }\n\n  function activateFrameworkControl(element) {\n    element.focus({ preventScroll: true });\n    dispatchPointerEvent(element, \"pointerdown\", 1);\n    dispatchMouseEvent(element, \"mousedown\", 1);\n    dispatchPointerEvent(element, \"pointerup\", 0);\n    dispatchMouseEvent(element, \"mouseup\", 0);\n    element.click();\n  }\n\n  function getStoredFrameworkTab() {\n    try {\n      return window.localStorage.getItem(storageKey);\n    } catch {\n      return null;\n    }\n  }\n\n  function setStoredFrameworkTab(label) {\n    try {\n      window.localStorage.setItem(storageKey, label);\n    } catch {\n      // Ignore storage failures so docs navigation still works normally.\n    }\n  }\n\n  function rememberFrameworkTab(event) {\n    if (\n      applyingStoredTab ||\n      !isStartFlowPage() ||\n      !(event.target instanceof Element)\n    ) {\n      return;\n    }\n\n    const control = event.target.closest(controlSelector);\n    if (!isFrameworkControl(control)) {\n      return;\n    }\n\n    setStoredFrameworkTab(getElementFrameworkLabel(control));\n  }\n\n  function rememberFrameworkTabFromKeyboard(event) {\n    if (event.key === \"Enter\" || event.key === \" \") {\n      rememberFrameworkTab(event);\n    }\n  }\n\n  function applyStoredFrameworkTab() {\n    if (applyQueued) {\n      return;\n    }\n\n    applyQueued = true;\n    window.requestAnimationFrame(() =\u003e {\n      applyQueued = false;\n\n      if (!isStartFlowPage()) {\n        return;\n      }\n\n      const label = getStoredFrameworkTab();\n      if (!frameworks.has(label)) {\n        return;\n      }\n\n      const controls = findFrameworkControls(label);\n      if (!controls.length || controls.some(isSelected)) {\n        return;\n      }\n\n      applyingStoredTab = true;\n      try {\n        activateFrameworkControl(controls[0]);\n      } finally {\n        applyingStoredTab = false;\n      }\n    });\n  }\n\n  document.addEventListener(\"pointerdown\", rememberFrameworkTab, true);\n  document.addEventListener(\"click\", rememberFrameworkTab, true);\n  document.addEventListener(\"keydown\", rememberFrameworkTabFromKeyboard, true);\n  document.addEventListener(\"DOMContentLoaded\", applyStoredFrameworkTab);\n  window.addEventListener(\"load\", applyStoredFrameworkTab);\n  window.addEventListener(\"pageshow\", applyStoredFrameworkTab);\n  window.addEventListener(\"popstate\", applyStoredFrameworkTab);\n\n  const observer = new MutationObserver(applyStoredFrameworkTab);\n  observer.observe(document.documentElement, {\n    childList: true,\n    subtree: true,\n  });\n\n  applyStoredFrameworkTab();\n})();\n"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"$L5b\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"6859e7f1a56347c82bb46e66\",\"filePath\":\"override.js\",\"subdomain\":\"paradedb\",\"__v\":0,\"content\":\"$5c\"}]}]\n5f:T2f89,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];const Architecture=()=\u003e_jsx(`figure`,{className:`architecture-diagram not-prose`,role:`img`,\"aria-label\":`ParadeDB architecture. Your application connects to Postgres through SQL. Inside Postgres, your tables are indexed by the pg_search extension, with index updates in the same transaction as table writes. One ParadeDB Index combines an inverted index for text, a clustered index for vectors, and columnar storage for filters and aggregates.`,children:_jsxs(`div`,{\"aria-hidden\":`true`,children:[_jsxs(`div`,{className:`architecture-app`,children:[_jsxs(`svg`,{viewBox:`0 0 24 24`,fill:`none`,stroke:`currentColor`,strokeWidth:`1.5`,children:[_jsx(`rect`,{x:`3`,y: