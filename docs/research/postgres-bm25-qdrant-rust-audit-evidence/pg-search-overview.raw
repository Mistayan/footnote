sx(`circle`,{cx:`40`,cy:`28`,r:`4`,fill:`var(--architecture-index)`}),_jsx(`circle`,{cx:`53`,cy:`9`,r:`4`,fill:`var(--architecture-index)`}),_jsx(`circle`,{cx:`27`,cy:`12`,r:`9`,opacity:`.2`})]}),_jsx(`div`,{className:`architecture-title`,children:`Vector`}),_jsx(`div`,{className:`architecture-detail`,children:`Clustered index`})]}),_jsxs(`div`,{className:`architecture-structure`,children:[_jsxs(`svg`,{viewBox:`0 0 64 40`,fill:`none`,stroke:`currentColor`,strokeWidth:`1.5`,children:[_jsx(`rect`,{x:`7`,y:`3`,width:`12`,height:`35`}),_jsx(`rect`,{x:`26`,y:`3`,width:`12`,height:`35`,fill:`currentColor`,fillOpacity:`.2`}),_jsx(`rect`,{x:`45`,y:`3`,width:`12`,height:`35`}),_jsx(`path`,{d:`M7 12h12M7 21h12M7 30h12M26 12h12M26 21h12M26 30h12M45 12h12M45 21h12M45 30h12`,opacity:`.6`})]}),_jsx(`div`,{className:`architecture-title`,children:`Filters and aggregates`}),_jsx(`div`,{className:`architecture-detail`,children:`Columnar`})]})]})]})]})]})});function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Card,CardGroup,Heading,_MdxComponentBoundary}=_components;if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!_MdxComponentBoundary)_missingMdxReference(`_MdxComponentBoundary`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`When Postgres queries get too slow, developers usually reach for systems like Elasticsearch. ParadeDB makes text and vector search, filters, facets, and joins fast in Postgres, so you can keep scaling with it.`}),`\n`,_jsxs(_components.p,{children:[`ParadeDB accelerates these queries with a custom index, delivered through the `,_jsx(_components.code,{children:`pg_search`}),` Postgres extension. It runs inside standard Postgres, with no fork or sidecar process.`]}),`\n`,_jsx(_MdxComponentBoundary,{name:`Architecture`,children:_jsx(Architecture,{})}),`\n`,_jsx(Heading,{level:`2`,id:`who-is-paradedb-for`,children:`Who is ParadeDB for?`}),`\n`,_jsx(_components.p,{children:`You’re likely a good fit for ParadeDB if:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re outgrowing Postgres full-text search or pgvector.`}),` Your queries are getting slower, index builds are taking too long, or you’re spending too much time working around feature limits and tuning performance.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re building an application that needs both transactions and search.`}),` You want user-facing search, RAG, or live dashboards without managing multiple databases and the pipelines that keep them in sync.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re already syncing Postgres with an external search engine like Elasticsearch.`}),` You’re spending too much time on reindexing, data pipelines, and denormalization, and want to keep Postgres JOINs and transactional guarantees.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`why-use-paradedb`,children:`Why Use ParadeDB?`}),`\n`,_jsx(_components.p,{children:`Keep scaling with Postgres as your queries and workloads grow more demanding.`}),`\n`,_jsx(Heading,{level:`3`,id:`no-second-system`,children:`No Second System`}),`\n`,_jsx(_components.p,{children:`With external search engines and vector stores, you have to manage sync jobs, duplicated schemas, denormalization, freshness checks, and failures across systems. ParadeDB keeps these workloads in Postgres, so index updates happen with your writes and queries run directly against your application data.`}),`\n`,_jsx(Heading,{level:`3`,id:`postgres-native-developer-experience`,children:`Postgres-Native Developer Experience`}),`\n`,_jsx(_components.p,{children:`Create indexes and query them with SQL. Full-text search, vector retrieval, hybrid search, filters, joins, facets, and aggregations compose with the schema and tools you already use.`}),`\n`,_jsx(Heading,{level:`3`,id:`built-for-demanding-queries`,children:`Built for Demanding Queries`}),`\n`,_jsx(_components.p,{children:`ParadeDB indexes serve lexical search, vector retrieval, ranking, filtering, and aggregations from a single wide index. Queries run faster because these operations execute together on dense data structures, rather than combining results from separate scans, indexes, or systems. You get the capabilities and performance of a standalone search engine without giving up Postgres transactions and ACID guarantees.`}),`\n`,_jsx(Heading,{level:`2`,id:`who-uses-paradedb`,children:`Who Uses ParadeDB?`}),`\n`,_jsx(_components.p,{children:`ParadeDB powers core search and analytics workloads at organizations ranging from Fortune 500 companies to fast-growing startups.`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Alibaba Cloud`}),` (`,_jsx(_components.a,{href:`https://www.paradedb.com/customers/alibaba`,children:`case study`}),`), the cloud computing arm of Alibaba Group and the largest Asia-Pacific cloud provider.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Bilt Rewards`}),` (`,_jsx(_components.a,{href:`https://www.paradedb.com/customers/bilt`,children:`case study`}),`), a rent payments technology company that processed over $36B in payments in 2024.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Modern Treasury`}),` (`,_jsx(_components.a,{href:`https://www.paradedb.com/customers/moderntreasury`,children:`case study`}),`), a financial technology company that automates the full cycle of money movement.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Cofactr`}),` (`,_jsx(_components.a,{href:`https://www.paradedb.com/customers/cofactr`,children:`case study`}),`), a full-service electronics purchasing platform for hardware teams.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`See all our `,_jsx(_components.a,{href:`https://paradedb.com/customers`,children:`case studies`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`next-steps`,children:`Next Steps`}),`\n`,_jsxs(CardGroup,{cols:2,children:[_jsx(Card,{title:`Getting Started`,icon:`forward-fast`,href:`/start/install`,children:_jsx(_components.p,{children:`Install ParadeDB and run your first queries.`})}),_jsx(Card,{title:`Architecture`,icon:`diagram-project`,href:`/concepts/architecture`,children:_jsx(_components.p,{children:`Learn how ParadeDB is built.`})}),_jsx(Card,{title:`Reference`,icon:`magnifying-glass`,href:`/reference/overview`,children:_jsx(_components.p,{children:`Indexing, query types, tokenizers, vectors, and aggregates.`})}),_jsx(Card,{title:`Deploy`,icon:`server`,href:`/operate/deploy/overview`,children:_jsx(_components.p,{children:`Deploy ParadeDB in our cloud or on your own infrastructure.`})})]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{Architecture,default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"60:T19b0,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];const Architecture=()=\u003enull;function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Card,CardGroup,Heading,_MdxComponentBoundary}=_components;if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!_MdxComponentBoundary)_missingMdxReference(`_MdxComponentBoundary`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`When Postgres queries get too slow, developers usually reach for systems like Elasticsearch. ParadeDB makes text and vector search, filters, facets, and joins fast in Postgres, so you can keep scaling with it.`}),`\n`,_jsxs(_components.p,{children:[`ParadeDB accelerates these queries with a custom index, delivered through the `,_jsx(_components.code,{children:`pg_search`}),` Postgres extension. It runs inside standard Postgres, with no fork or sidecar process.`]}),`\n`,_jsx(_MdxComponentBoundary,{name:`Architecture`,children:_jsx(Architecture,{})}),`\n`,_jsx(Heading,{level:`2`,id:`who-is-paradedb-for`,children:`Who is ParadeDB for?`}),`\n`,_jsx(_components.p,{children:`You’re likely a good fit for ParadeDB if:`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re outgrowing Postgres full-text search or pgvector.`}),` Your queries are getting slower, index builds are taking too long, or you’re spending too much time working around feature limits and tuning performance.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re building an application that needs both transactions and search.`}),` You want user-facing search, RAG, or live dashboards without managing multiple databases and the pipelines that keep them in sync.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`You’re already syncing Postgres with an external search engine like Elasticsearch.`}),` You’re spending too much time on reindexing, data pipelines, and denormalization, and want to keep Postgres JOINs and transactional guarantees.`]}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`why-use-paradedb`,children:`Why Use ParadeDB?`}),`\n`,_jsx(_components.p,{children:`Keep scaling with Postgres as your queries and workloads grow more demanding.`}),